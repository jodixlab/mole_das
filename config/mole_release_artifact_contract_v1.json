{
  "schema": "mole_release_artifact_contract_source_v1",
  "artifacts": [
    {
      "id": "runtime_zip",
      "required": true,
      "match": "glob",
      "pattern": "*_RUNTIME_READY_FULL_DATA.zip",
      "description": "Certified runtime ZIP generated from the clean workspace."
    },
    {
      "id": "release_cert_json",
      "required": true,
      "match": "glob",
      "pattern": "RELEASE_CERT_*.json",
      "description": "Structured release certificate emitted by the release gate."
    },
    {
      "id": "release_cert_txt",
      "required": true,
      "match": "glob",
      "pattern": "RELEASE_CERT_*.txt",
      "description": "Human-readable release certificate emitted by the release gate."
    },
    {
      "id": "release_hygiene_json",
      "required": true,
      "match": "glob",
      "pattern": "RELEASE_HYGIENE_*.json",
      "description": "Structured package hygiene audit for the runtime ZIP."
    },
    {
      "id": "release_hygiene_txt",
      "required": true,
      "match": "glob",
      "pattern": "RELEASE_HYGIENE_*.txt",
      "description": "Human-readable package hygiene audit for the runtime ZIP."
    },
    {
      "id": "installer_exe_bundle_zip",
      "required": true,
      "match": "glob",
      "pattern": "*_installer_exe_bundle.zip",
      "description": "Installer-grade Windows executable bundle ZIP produced by the clean release workflow."
    },
    {
      "id": "portable_exe_bundle_zip",
      "required": true,
      "match": "glob",
      "pattern": "*_portable_exe_bundle.zip",
      "description": "Portable Windows executable bundle ZIP produced by the clean release workflow."
    },
    {
      "id": "clean_release_summary_json",
      "required": true,
      "match": "exact",
      "pattern": "clean_release_summary.json",
      "description": "Structured clean-workspace workflow summary."
    },
    {
      "id": "clean_release_summary_txt",
      "required": true,
      "match": "exact",
      "pattern": "clean_release_summary.txt",
      "description": "Human-readable clean-workspace workflow summary."
    },
    {
      "id": "packaged_acceptance_summary_json",
      "required": true,
      "match": "exact",
      "pattern": "packaged_acceptance_summary.json",
      "description": "Structured installed-package acceptance summary for the executable bundle."
    },
    {
      "id": "packaged_acceptance_summary_txt",
      "required": true,
      "match": "exact",
      "pattern": "packaged_acceptance_summary.txt",
      "description": "Human-readable installed-package acceptance summary for the executable bundle."
    },
    {
      "id": "latest_verified_release_manifest_json",
      "required": true,
      "match": "exact",
      "pattern": "latest_verified_release_v1.json",
      "description": "Canonical verified release channel manifest emitted by the executable bundle and release workflow."
    },
    {
      "id": "latest_verified_release_signature_json",
      "required": true,
      "match": "exact",
      "pattern": "latest_verified_release_v1.signature.json",
      "description": "Cryptographic signature for the canonical verified release channel manifest."
    },
    {
      "id": "release_signing_public_key_json",
      "required": true,
      "match": "exact",
      "pattern": "mole_release_signing_public_key_v1.json",
      "description": "Public signing key used to verify the canonical verified release channel manifest."
    },
    {
      "id": "package_version_audit_json",
      "required": true,
      "match": "exact",
      "pattern": "PACKAGE_VERSION_AUDIT.json",
      "description": "Structured bundle-wide package version coherence audit emitted by the executable bundle builder."
    },
    {
      "id": "package_version_audit_txt",
      "required": true,
      "match": "exact",
      "pattern": "PACKAGE_VERSION_AUDIT.txt",
      "description": "Human-readable bundle-wide package version coherence audit emitted by the executable bundle builder."
    },
    {
      "id": "upgrade_report_preview_json",
      "required": true,
      "match": "exact",
      "pattern": "UPGRADE_REPORT_PREVIEW.json",
      "description": "Structured exported upgrade and migration preview generated by the install client and published with the verified bundle."
    },
    {
      "id": "upgrade_report_preview_txt",
      "required": true,
      "match": "exact",
      "pattern": "UPGRADE_REPORT_PREVIEW.txt",
      "description": "Human-readable exported upgrade and migration preview generated by the install client and published with the verified bundle."
    },
    {
      "id": "rollback_report_preview_json",
      "required": true,
      "match": "exact",
      "pattern": "ROLLBACK_REPORT_PREVIEW.json",
      "description": "Structured exported rollback and restore preview generated by the install client and published with the verified bundle."
    },
    {
      "id": "rollback_report_preview_txt",
      "required": true,
      "match": "exact",
      "pattern": "ROLLBACK_REPORT_PREVIEW.txt",
      "description": "Human-readable exported rollback and restore preview generated by the install client and published with the verified bundle."
    },
    {
      "id": "ui_help_audit_json",
      "required": true,
      "match": "exact",
      "pattern": "ui_help_audit.json",
      "description": "Structured UI help coverage audit emitted by the clean release workflow."
    },
    {
      "id": "ui_help_audit_txt",
      "required": true,
      "match": "exact",
      "pattern": "ui_help_audit.txt",
      "description": "Human-readable UI help coverage audit emitted by the clean release workflow."
    },
    {
      "id": "ui_help_doc_update_pack_json",
      "required": true,
      "match": "exact",
      "pattern": "ui_help_doc_update_pack.json",
      "description": "Structured UI help documentation change review pack."
    },
    {
      "id": "ui_help_doc_update_pack_md",
      "required": true,
      "match": "exact",
      "pattern": "ui_help_doc_update_pack.md",
      "description": "Human-readable UI help documentation change review pack."
    },
    {
      "id": "production_acceptance_matrix_md",
      "required": true,
      "match": "exact",
      "pattern": "production_acceptance_matrix.md",
      "description": "Operator-facing production acceptance matrix."
    },
    {
      "id": "production_acceptance_matrix_csv",
      "required": true,
      "match": "exact",
      "pattern": "production_acceptance_matrix.csv",
      "description": "CSV export of the production acceptance matrix."
    },
    {
      "id": "operator_go_no_go_checklist_md",
      "required": true,
      "match": "exact",
      "pattern": "operator_go_no_go_checklist.md",
      "description": "Operator go/no-go checklist."
    },
    {
      "id": "operator_go_no_go_checklist_json",
      "required": true,
      "match": "exact",
      "pattern": "operator_go_no_go_checklist.json",
      "description": "Structured operator go/no-go checklist."
    },
    {
      "id": "dependency_manifest_json",
      "required": true,
      "match": "exact",
      "pattern": "dependency_manifest.json",
      "description": "Structured dependency manifest from the clean runtime."
    },
    {
      "id": "dependency_manifest_txt",
      "required": true,
      "match": "exact",
      "pattern": "dependency_manifest.txt",
      "description": "Freeze-style dependency manifest from the clean runtime."
    },
    {
      "id": "welcome_asset_manifest_json",
      "required": true,
      "match": "exact",
      "pattern": "welcome_asset_manifest.json",
      "description": "Structured welcome animation asset manifest copied into the release artifact set."
    },
    {
      "id": "welcome_asset_review_json",
      "required": true,
      "match": "exact",
      "pattern": "welcome_asset_review.json",
      "description": "Structured review summary for the approved welcome animation asset."
    },
    {
      "id": "welcome_asset_review_md",
      "required": true,
      "match": "exact",
      "pattern": "welcome_asset_review.md",
      "description": "Human-readable review summary for the approved welcome animation asset."
    },
    {
      "id": "welcome_asset_contact_sheet_png",
      "required": true,
      "match": "exact",
      "pattern": "welcome_asset_contact_sheet.png",
      "description": "Contact sheet preview of the welcome animation frames."
    },
    {
      "id": "welcome_asset_preview_gif",
      "required": true,
      "match": "exact",
      "pattern": "welcome_asset_preview.gif",
      "description": "Looping preview GIF of the welcome animation asset."
    },
    {
      "id": "release_bundle_summary_json",
      "required": true,
      "match": "exact",
      "pattern": "release_bundle_summary.json",
      "description": "Structured release bundle pass/fail summary."
    },
    {
      "id": "release_bundle_summary_md",
      "required": true,
      "match": "exact",
      "pattern": "release_bundle_summary.md",
      "description": "Human-readable release bundle pass/fail summary."
    },
    {
      "id": "release_artifact_contract_json",
      "required": true,
      "match": "exact",
      "pattern": "release_artifact_contract.json",
      "description": "Structured release artifact contract."
    },
    {
      "id": "release_artifact_contract_md",
      "required": true,
      "match": "exact",
      "pattern": "release_artifact_contract.md",
      "description": "Human-readable release artifact contract."
    },
    {
      "id": "release_go_no_go_decision_json",
      "required": true,
      "match": "exact",
      "pattern": "release_go_no_go_decision.json",
      "description": "Structured release go/no-go decision."
    },
    {
      "id": "release_go_no_go_decision_md",
      "required": true,
      "match": "exact",
      "pattern": "release_go_no_go_decision.md",
      "description": "Human-readable release go/no-go decision."
    }
  ]
}
